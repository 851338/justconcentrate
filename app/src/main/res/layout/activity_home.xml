<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".view.HomeActivity">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_action_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ab_title"
            style="@style/TextTitleStyle"
            android:text="@string/main_title"
            android:textColor="@color/text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_back"
            style="@style/ButtonActionBar"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_back" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/ic_setting" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Card Grid -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_action_bar">

        <!-- Card: Tasks -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_tasks"
            style="@style/CardViewMainActivity"
            app:layout_constraintEnd_toStartOf="@id/card_concentrate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_task"
                    style="@style/ButtonMainActivity"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_task" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextStyle"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_title" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Concentrate -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_concentrate"
            style="@style/CardViewMainActivity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_tasks"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_concentrate"
                    style="@style/ButtonMainActivity"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_concentrate" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextStyle"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/concentrate_title" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Stats -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_stats"
            style="@style/CardViewMainActivity"
            app:layout_constraintTop_toBottomOf="@id/card_tasks"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/card_achievements">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_stats"
                    style="@style/ButtonMainActivity"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_stats" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextStyle"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_title" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Achievements -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_achievements"
            style="@style/CardViewMainActivity"
            app:layout_constraintTop_toBottomOf="@id/card_concentrate"
            app:layout_constraintStart_toEndOf="@id/card_stats"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_achievements"
                    style="@style/ButtonMainActivity"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_achievements" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextStyle"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/achievements" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Ads -->
    <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-9156563357147909/6188577744"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Fragment Container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layout_action_bar"
        app:layout_constraintBottom_toTopOf="@id/adView" />
</androidx.constraintlayout.widget.ConstraintLayout>
