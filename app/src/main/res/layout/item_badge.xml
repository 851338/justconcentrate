<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageBadgeIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        tools:src="@drawable/ic_achievements"
        android:contentDescription="@string/badge_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/textBadgeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Badge Name"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textBadgeDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Badge description goes here"
            android:textSize="14sp"
            android:textColor="#666666" />

        <!-- Optional: Progress Bar for locked badges -->
        <ProgressBar
            android:id="@+id/progressBadge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="50"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>
