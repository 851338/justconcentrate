<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_2sdp"
    android:layout_marginTop="@dimen/_2sdp"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/bg_conner_15_v1"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardElevation="@dimen/_3sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_64sdp"
        android:paddingStart="@dimen/_15sdp"
        android:paddingEnd="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img_language"
            android:layout_width="@dimen/_32dp"
            android:layout_height="@dimen/_32dp"
            android:scaleType="centerCrop"
            android:src="@drawable/app_ic_english"
            app:civ_border_color="@android:color/transparent"
            app:civ_border_width="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title_language"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semi_bold"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="@dimen/_6sdp"
            android:text="@string/english"
            android:textColor="@color/black"
            android:textSize="@dimen/txt_16sp"
            app:layout_constraintBottom_toTopOf="@+id/tv_title_second"
            app:layout_constraintEnd_toStartOf="@+id/checkbox_language"
            app:layout_constraintStart_toEndOf="@+id/img_language"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title_second"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:fontFamily="@font/figtree_semi_bold"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_marginBottom="16dp"
            android:text="@string/portuguese"
            android:textColor="@color/gray"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/checkbox_language"
            app:layout_constraintStart_toEndOf="@+id/img_language"
            app:layout_constraintTop_toBottomOf="@id/tv_title_language" />

        <RadioButton
            android:id="@+id/checkbox_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:theme="@style/RadioButtonMain"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>