<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.JustConcentration" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowSplashScreenBackground">@color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/black</item>
        <!-- Remove default ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.JustConcentration" parent="Base.Theme.JustConcentration">
        <item name="colorSurface">@android:color/white</item>
        <!-- Potentially also override colorSurfaceContainer and colorSurfaceBright if needed -->
        <item name="colorSurfaceContainer">@android:color/white</item>
        <item name="colorSurfaceBright">@android:color/white</item>
        <item name="colorSurfaceVariant">@android:color/white</item> <!-- ADD THIS -->
        <item name="colorOnSurface">@android:color/black</item> <!-- Keep text visible -->
        <item name="colorOnBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/white</item>
        <!--        <item name="android:windowBackground">@drawable/app_bg</item>-->
        <item name="android:colorBackground">@android:color/white</item>
    </style>
</resources>